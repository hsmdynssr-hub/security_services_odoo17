<odoo>
    <record id="view_security_contract_tree" model="ir.ui.view">
        <field name="name">security.contract.tree</field>
        <field name="model">security.contract</field>
        <field name="arch" type="xml">
            <tree>
                <field name="contract_no"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="monthly_amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_security_contract_form" model="ir.ui.view">
        <field name="name">security.contract.form</field>
        <field name="model">security.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="contract_no"/>
                        <field name="partner_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="monthly_amount"/>
                        <field name="state"/>
                    </group>
                    <notebook>
                        <page string="Contract Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="site_id"/>
                                    <field name="service_type"/>
                                    <field name="guards_count"/>
                                    <field name="monthly_price"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_security_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">security.contract</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_security_contract_action"
              parent="menu_security_contracts"
              action="action_security_contract"
              sequence="1"/>
</odoo>
