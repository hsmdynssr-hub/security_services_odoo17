<odoo>
    <record id="view_security_attendance_tree" model="ir.ui.view">
        <field name="name">security.attendance.tree</field>
        <field name="model">security.attendance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="site_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="action_security_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">security.attendance</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_security_attendance_action"
              parent="menu_security_operations"
              action="action_security_attendance"
              sequence="1"/>
</odoo>
