<odoo>
    <record id="view_security_site_tree" model="ir.ui.view">
        <field name="name">security.client.site.tree</field>
        <field name="model">security.client.site</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="risk_level"/>
            </tree>
        </field>
    </record>

    <record id="action_security_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">security.client.site</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_security_site_action"
              parent="menu_security_sites"
              action="action_security_site"
              sequence="1"/>
</odoo>
